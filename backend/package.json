{
  "name": "wb-oidc-backend",
  "version": "0.1.0",
  "description": "OIDC Provider (NestJS + oidc-provider) for C端用户授权登录",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/gen-build-info.js",
    "start": "node dist/main.js",
    "start:dev": "npm run build && node dist/main.js",
    "seed": "npm run build && node scripts/seed.mjs",
    "db:reinit": "npm run build && node scripts/db-reinit.mjs",
    "migration:run": "npm run build && typeorm migration:run -d dist/db/cli-datasource.js",
    "migration:revert": "npm run build && typeorm migration:revert -d dist/db/cli-datasource.js",
    "migration:show": "npm run build && typeorm migration:show -d dist/db/cli-datasource.js",
    "reset-admin": "node scripts/reset-admin.mjs",
    "smoke:admin": "node scripts/smoke-admin.mjs",
    "smoke:password": "node scripts/smoke-change-password.mjs",
    "smoke:all": "node scripts/smoke-all.mjs",
    "smoke:profile": "node scripts/smoke-profile.mjs",
    "smoke:app-meta": "node scripts/smoke-app-meta.mjs",
    "smoke:secret": "node scripts/smoke-secret.mjs",
    "verify-legacy": "node scripts/verify-legacy.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.4.8",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "oidc-provider": "^8.0.0",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/swagger-ui-express": "^4.1.8",
    "typescript": "^5.5.0"
  }
}
