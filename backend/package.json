{
  "name": "wb-oidc-backend",
  "version": "0.1.0",
  "description": "OIDC Provider (NestJS + oidc-provider) for C端用户授权登录",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "npm run build && node dist/main.js",
    "seed": "node scripts/seed.mjs",
    "reset-admin": "node scripts/reset-admin.mjs",
    "smoke:admin": "node scripts/smoke-admin.mjs",
    "smoke:password": "node scripts/smoke-change-password.mjs",
    "smoke:all": "node scripts/smoke-all.mjs",
    "smoke:profile": "node scripts/smoke-profile.mjs",
    "verify-legacy": "node scripts/verify-legacy.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "oidc-provider": "^8.0.0",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.5.0"
  }
}
