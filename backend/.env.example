# ===== OIDC 服务 =====
PORT=3000
# 对外 issuer，生产环境必须换成 https 域名
ISSUER=http://localhost:3000
# ===== 管理端登录（独立管理员表 oidc_admin）=====
# access token 签名密钥：随机 48 字符以上，务必与生产一致
ADMIN_JWT_SECRET=please-change-me-to-a-random-secret
# access token 有效期（秒）
ADMIN_ACCESS_TTL=900
# refresh token 有效期（天），刷新即轮换、服务端可吊销
ADMIN_REFRESH_TTL_DAYS=7
# https 环境置 true（cookie 只走 https）
ADMIN_COOKIE_SECURE=false
# 首次 seed 创建的管理员；密码留空则随机生成并打印一次
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=
# oidc-provider cookie 签名密钥，随机字符串即可
OIDC_COOKIE_SECRET=please-change-me-to-a-random-string
# 允许跨域的前端来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173

# ===== PostgreSQL（存授权数据：会话/code/token/grant/客户端）=====
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=wb_oidc

# ===== 老系统 PostgreSQL（只读，仅用于校验存量用户）=====
# 若与上面 PG_* 是同一个实例，这里填同样的连接信息、换数据库名即可
LEGACY_DB_HOST=localhost
LEGACY_DB_PORT=5432
LEGACY_DB_USER=postgres
LEGACY_DB_PASSWORD=postgres
LEGACY_DB_NAME=your_legacy_db

# 老系统用户表与字段（按实际表结构调整；PG 中大写表名需原样填写，如 USER）
LEGACY_USER_TABLE=users
LEGACY_ID_FIELD=id
LEGACY_USERNAME_FIELD=username
LEGACY_PASSWORD_FIELD=password
# 密码哈希算法：bcrypt | md5 | sha1 | sha256 | sha256-b64 | hmac-sha256-b64 | plain
LEGACY_PASSWORD_HASH=bcrypt
# hmac-sha256-b64 时的密钥（老系统常见：moondropapp&&）
LEGACY_HMAC_KEY=
# 若密码加盐：盐字段名 / 静态盐 / 盐拼接位置（prefix|suffix）
LEGACY_SALT_FIELD=
LEGACY_STATIC_SALT=
LEGACY_SALT_POSITION=prefix
# 账号状态过滤：状态字段与允许值，留空则不校验（如 status=1 为正常）
LEGACY_STATUS_FIELD=
LEGACY_STATUS_ACTIVE=1

# 用于 OIDC claims 的字段映射
LEGACY_NICKNAME_FIELD=nickname
LEGACY_EMAIL_FIELD=email
LEGACY_PHONE_FIELD=phone
LEGACY_AVATAR_FIELD=avatar
